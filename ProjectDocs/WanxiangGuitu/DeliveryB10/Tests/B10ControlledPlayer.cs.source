using System;using System.IO;using System.Linq;using UnityEngine;using UnityEngine.UI;using Unity.Profiling;

// TEST BUILD ONLY. Real uGUI callbacks, explicitly NOT native mouse/keyboard acceptance.
public sealed class B10ControlledPlayer:MonoBehaviour {
 static string root,scenario;float deadline,notBefore;int phase,frame,page;CombatSession session;string expected,stamp;bool ready;ProfilerRecorder mainThread,gc,draw;long mainTotal,gcTotal,drawTotal;int samples;float entryReady;
 [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)] static void Begin(){var args=Environment.GetCommandLineArgs();if(Array.IndexOf(args,"-wanxiang-controlled-player")<0)return;try{root=ValidationStorage.Root(args,true);int n=Array.IndexOf(args,"-wanxiang-controlled-case");scenario=n>=0&&n+1<args.Length?args[n+1]:"";if(!new[]{"read","continue","new","pending"}.Contains(scenario))throw new IOException("Controlled case not explicit");var g=new GameObject("B10 explicit controlled Player driver");DontDestroyOnLoad(g);g.AddComponent<B10ControlledPlayer>();}catch(Exception e){Debug.LogError("B10_CONTROLLED_LAUNCH_REJECTED "+e.Message);Application.Quit(2);}}
 void Start(){try{mainThread=ProfilerRecorder.StartNew(ProfilerCategory.Internal,"Main Thread",1);gc=ProfilerRecorder.StartNew(ProfilerCategory.Memory,"GC Allocated In Frame",1);draw=ProfilerRecorder.StartNew(ProfilerCategory.Render,"Draw Calls Count",1);}catch(Exception e){Log("PERFORMANCE_COUNTER_UNAVAILABLE "+e.Message);}deadline=Time.realtimeSinceStartup+150;Log("scope: separate nondevelopment validation build, uGUI callbacks, NOT native input");}
 static void Need(bool b,string message){if(!b)throw new Exception(message);}
 static void Log(string message){File.AppendAllText(Path.Combine(root,"b10-controlled-actions.txt"),DateTime.UtcNow.ToString("o")+" "+message+"\n");}
 static Button Find(string name)=>UnityEngine.Object.FindObjectsByType<Button>(FindObjectsSortMode.None).FirstOrDefault(b=>b.name==name&&b.gameObject.activeInHierarchy);
 static void Click(string name){var b=Find(name);Need(b!=null&&b.interactable,"button unavailable "+name);Log("CONTROLLED_UGUI "+name);b.onClick.Invoke();}
 void Shot(string name){ScreenCapture.CaptureScreenshot(Path.Combine(root,"b10-player-"+name+".png"));frame=Time.frameCount;notBefore=Time.realtimeSinceStartup+.22f;}
 static string Invariant(CombatSaveData data){var run=data.hasActiveRun?data.activeRun:null;var world=run?.checkpoint??data.profile.camp;return JsonUtility.ToJson(data.profile)+"\n"+(run==null?"no-run":run.runId+"/"+run.regionInstanceId+"/"+run.seed+"\n"+JsonUtility.ToJson(run.randomStreams)+"\n"+JsonUtility.ToJson(world.forest)+"\n"+string.Join(",",run.broughtRemaining)+"/"+string.Join(",",run.earnedRemaining))+"\n"+string.Join("|",(world.gear??new GearItem[0]).Select(g=>JsonUtility.ToJson(g)))+"\n"+world.mainWeapon+"/"+world.reserveWeapon+"\n"+string.Join(",",world.materials??new int[6])+"\n"+(data.hasSettlement?JsonUtility.ToJson(data.settlement):"no-settlement");}
 void Update(){try{if(ready)return;if(Time.realtimeSinceStartup>deadline)throw new Exception("controlled Player deadline phase "+phase);if(phase>0&&(Time.frameCount<frame+18||Time.realtimeSinceStartup<notBefore))return;
  if(phase==0){if(GameEntry.Instance==null||GameEntry.Instance.GetComponent<TitleMenu>()?.Canvas==null||Find("新游戏")==null||Time.frameCount<45)return;Need(UnityEngine.Object.FindFirstObjectByType<CombatSession>()==null,"gameplay leaked before choice");Need(GameEntry.TestRoot==root,"root changed after launch");var entry=GameEntry.Instance;stamp=SaveCatalog.Fingerprint(entry.CurrentDirectory);Need(entry.Info.canContinue==(scenario!="new"),"catalog state wrong");if(entry.Info.canContinue)expected=Invariant(CombatSaveSystem.InspectReadOnly(Path.Combine(entry.CurrentDirectory,"save.json")));entryReady=Time.realtimeSinceStartup;Shot("title");phase=1;return;}
  if(phase==1){Click("设置");Shot("settings");phase=2;return;}
  if(phase==2){Click("取消返回");Click("新游戏");Shot("new-confirmation");phase=3;return;}
  if(phase==3){Click("取消，保留当前进度");Need(SaveCatalog.Fingerprint(GameEntry.Instance.CurrentDirectory)==stamp,"new cancel mutated save");Click("读取存档");Shot("save-page");phase=4;return;}
  if(phase==4){if(scenario=="new"){Need(!Find("读取所示自动档").interactable,"missing save read enabled");Click("返回");Click("新游戏");Click("确认建立新档案");}else if(scenario=="continue"){Click("返回");Click("继续游戏");}else Click("读取所示自动档");phase=5;frame=Time.frameCount;return;}
  if(phase==5){session=UnityEngine.Object.FindFirstObjectByType<CombatSession>();if(session==null||!session.Saves.IsInitialized||GameEntry.Loading||session.hero.GetComponent<CatActorVisual>()?.Ready!=true)return;Need(session.GetComponent<CatInventoryPresenter>()!=null,"new inventory missing");if(scenario=="new")Need(session.Flow.AtCamp&&session.Flow.ActiveRun==null,"new profile must camp, not auto-run");else Need(Invariant(CombatSaveSystem.InspectReadOnly(session.Saves.SavePath))==expected,"entry changed profile/run/layout/rewards/ledger");Log("GAME_READY cat=true newUI=true scene="+session.gameObject.scene.name);Shot(session.Flow.HasResult?"settlement":"game-ready");phase=6;return;}
  if(phase==6){if(session.Flow.HasResult){Need(GameEntry.ReturnToTitle(session),"pending return cannot preserve save");phase=10;return;}if(session.hero.Inventory.IsOpen)Click("关闭");else if(session.Flow.AtCamp)session.Camp.Explore();frame=Time.frameCount;phase=7;return;}
  if(phase==7){Click("补给");frame=Time.frameCount;phase=8;page=0;return;}
  if(phase==8){if(!CatInventoryPresenter.Instance.Visible)return;string[] names={"背包与胸挂","角色","营地仓库"};if(page<names.Length){Click(names[page]);page++;frame=Time.frameCount;notBefore=Time.realtimeSinceStartup+.22f;phase=81;return;}if(session.Flow.AtCamp){Click("营地工作台");frame=Time.frameCount;notBefore=Time.realtimeSinceStartup+.22f;phase=82;return;}phase=9;return;}
  if(phase==81){Need(CatInventoryPresenter.Instance.RenderedPage==session.hero.Inventory.CurrentPage,"page not rendered");Shot("inventory-"+(page-1));phase=8;return;}
  if(phase==82){Shot("workbench");phase=9;return;}
  if(phase==9){Click("关闭");Need(GameEntry.ReturnToTitle(session),"return-to-title save failed");phase=10;return;}
  if(phase==10){if(GameEntry.Instance==null||GameEntry.Loading||Find("退出游戏")==null)return;var path=Path.Combine(GameEntry.Instance.CurrentDirectory,"save.json");var data=CombatSaveSystem.InspectReadOnly(path);if(scenario!="new")Need(Invariant(data)==expected,"view/return mutated invariant or repeated rewards");File.WriteAllText(Path.Combine(root,"b10-controlled-result.json"),JsonUtility.ToJson(new Result{status="PASS",scope="Separate nondevelopment validation Player, real uGUI callbacks; NOT native/human",scenario=scenario,profile=data.profile.profileId,run=data.activeRun?.runId,regionInstance=data.activeRun?.regionInstanceId,seed=data.activeRun?.seed??0,revision=data.revision,quitRequested=true,random=JsonUtility.ToJson(data.activeRun?.randomStreams)},true));WritePerformance();ready=true;Click("退出游戏");}
 }catch(Exception e){Debug.LogException(e);File.WriteAllText(Path.Combine(root,"b10-controlled-result.json"),JsonUtility.ToJson(new Result{status="FAIL",scope="Controlled validation Player, NOT native",scenario=scenario,error=e.ToString(),quitRequested=false},true));ready=true;Application.Quit(3);}}
 void LateUpdate(){if(ready)return;if(mainThread.Valid)mainTotal+=mainThread.LastValue;if(gc.Valid)gcTotal+=gc.LastValue;if(draw.Valid)drawTotal+=draw.LastValue;samples++;}
 void OnDestroy(){mainThread.Dispose();gc.Dispose();draw.Dispose();}
 void WritePerformance(){var textures=Resources.FindObjectsOfTypeAll<Texture>();var m=new Performance{scope="Separate nondevelopment controlled Player, inactive desktop, menu/inventory sequence incl capture/driver overhead; not representative normal gameplay benchmark",samples=samples,titleReadySeconds=entryReady,textureObjects=textures.Length,textureMemoryBytes=textures.Sum(t=>UnityEngine.Profiling.Profiler.GetRuntimeMemorySizeLong(t)),materials=Resources.FindObjectsOfTypeAll<Material>().Length,mainThreadStatus=mainThread.Valid&&mainTotal>0?"PASS":"NOT_RUN",mainThreadAverageNs=mainThread.Valid&&samples>0?mainTotal/samples:0,gcStatus=gc.Valid?"PASS":"NOT_RUN",gcAverageBytes=gc.Valid&&samples>0?gcTotal/samples:0,drawCallsStatus=draw.Valid&&drawTotal>0?"PASS":"NOT_RUN",drawCallsAverage=draw.Valid&&samples>0?drawTotal/samples:0};File.WriteAllText(Path.Combine(root,"b10-performance.json"),JsonUtility.ToJson(m,true));}
 [Serializable] class Performance{public string scope,mainThreadStatus,gcStatus,drawCallsStatus;public int samples,textureObjects,materials;public float titleReadySeconds;public long textureMemoryBytes,mainThreadAverageNs,gcAverageBytes,drawCallsAverage;}
 [Serializable] class Result{public string status,scope,scenario,profile,run,regionInstance,random,error;public int seed;public long revision;public bool quitRequested;}
}
