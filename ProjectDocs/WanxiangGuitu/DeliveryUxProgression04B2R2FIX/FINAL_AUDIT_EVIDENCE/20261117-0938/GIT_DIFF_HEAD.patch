+    bool ApplyEquipment(string candidateId,string replacedId,Vector2Int target,B2EquipRole role,int rotation,bool replace,out string reason)
+    {
+        // Never trust a cached feasible flag or a UI-mutable projection. Revalidate now.
+        if(!ProjectEquipment(candidateId,replacedId,target,role,rotation,replace,out var projected,
+            out _,out _,out var swapped,out reason))return false;
+        var candidate=items.First(i=>i.id==candidateId);
+        bool success;
+        if(role==B2EquipRole.Main)success=SelectMain(candidate);
+        else if(role==B2EquipRole.Reserve)success=SelectReserve(candidate);
+        else if(role==B2EquipRole.Worn||role==B2EquipRole.ContainerRig||role==B2EquipRole.ContainerBag)
+            success=EquipContainer(candidate); // Preserve the existing camp save transaction.
+        else if(!replace||swapped)
+            success=Place(candidate,true,target.x,target.y,rotation==-1?candidate.rotation:rotation,swapped,out reason);
+        else
+        {
+            // Empty-target replacement was fully validated by the same PlaceState on clones.
+            // Commit both movements together; retain identities, stats, affixes and provenance.
+            foreach(var next in projected)
+            {
+                var real=items.First(i=>i.id==next.id);
+                real.x=next.x;real.y=next.y;real.rotation=next.rotation;
+                real.board=next.board;real.worn=next.worn;real.overflow=next.overflow;
+            }
+            Refresh();success=true;
+        }
+        if(!success&&string.IsNullOrEmpty(reason))reason="装备状态或存档就绪状态变化，未提交。";
+        return success;
+    }
