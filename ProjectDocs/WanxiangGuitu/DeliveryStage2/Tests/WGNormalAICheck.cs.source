 static void CheckExpected(){var now=Snapshot(expected.stage);Need(now.profile==expected.profile&&now.run==expected.run&&now.region==expected.region&&now.seed==expected.seed,"new process identity/seed");Need(now.hunts==expected.hunts&&now.layout==expected.layout&&now.streams==expected.streams&&now.ledger==expected.ledger&&now.gear==expected.gear&&now.entities==expected.entities&&now.ground==expected.ground&&now.receipt==expected.receipt&&now.warehouse==expected.warehouse&&now.recipes==expected.recipes,"new process layout/entities/gear/warehouse/recipes/ledger/RNG changed");Need(s.Flow.ActiveRun.checkpoint.loot.Select(l=>l.entityId).OrderBy(x=>x).SequenceEqual(UnityEngine.Object.FindObjectsByType<LootPickup>(FindObjectsSortMode.None).Select(l=>l.InteractionId).OrderBy(x=>x)),"runtime ground IDs changed on restore");RecordScoring(expected.stage,"restored");Mark("NEW_PROCESS_FULL_STATE_PASS stage="+expected.stage);}
