  if(phase==2){if(Walk(node.transform.position,(int)s.hero.GetComponent<AdventureLoadout>().Weapon>=2?3.8f:s.hero.GetComponent<AdventureLoadout>().Weapon==GearType.Spear?2.8f:2.0f))phase=3;return;}
