  if(phase==31){StopInput();if(s.Flow.HasResult){Need(s.Flow.Settlement.outcome==AdventureOutcome.Extracted&&s.Flow.Settlement.keptMaterials.Sum()>0,"extracted yield missing");if(Strategy=="Treasure")Need(s.Flow.Settlement.keptGear.Length>0,"treasure gear lost");Stage2Experiment.Pending(s);File.WriteAllText(Root+"/b4-first-settlement.json",JsonUtility.ToJson(s.Flow.Settlement,true));ScreenCapture.CaptureScreenshot(Root+"/first-settlement-"+Strategy+".png");phase=40;}else if(s.Flow.ActiveRun.phase==RunPhase.Running){phase=30;}return;}
  if(phase==40){Stage2Experiment.Record("before-commit");Need(s.Flow.CommitSettlement(),"commit settlement");string committed=JsonUtility.ToJson(s.Flow.Profile);s.Flow.CommitSettlement();Need(committed==JsonUtility.ToJson(s.Flow.Profile),"duplicate settlement award");Stage2Experiment.Record("committed-after-duplicate-check");Need(s.Flow.AcknowledgeSettlement(),"ack settlement");Stage2Experiment.Record("acknowledged");Stage2Experiment.Record("before-withdraw-materials");Need(s.Camp.TransferMaterial(MaterialKind.Wood,2,false)&&s.Camp.TransferMaterial(MaterialKind.Stone,1,false)&&s.Camp.TransferMaterial(MaterialKind.Ore,2,false),"withdraw real deposited materials");Stage2Experiment.Record("after-withdraw-materials");var g=s.hero.GetComponent<AdventureLoadout>();var ids=g.items.Select(i=>i.id).ToArray();float attack=s.hero.AttackPower,defense=s.hero.Defense;Need(Stage2Experiment.Cost("camp-build-growth",()=>g.Craft((GearType)Stage2Experiment.Config.target,GearQuality.White)),"actual build-growth manufacture");var made=g.items.Single(i=>!ids.Contains(i.id));Stage2Builds.Board(g,made);Stage2Experiment.Growth(s,attack,defense,made.id);Mark("REAL_SETTLEMENT_STORE_WITHDRAW_CRAFT");Need(s.Flow.Depart(AdventureMode.ForestExploration),"second forest departure");Need(s.Flow.ActiveRun.runId!=firstRun&&s.Flow.ActiveRun.mode==AdventureMode.ForestExploration,"successor not new forest");Mark("SECOND_FOREST_DEPARTED");Finish(2);return;}
 }catch(Exception e){Debug.LogException(e);EditorApplication.update-=Tick;try{Stage2Experiment.Failure(e);}catch(Exception reportError){Debug.LogException(reportError);}if(kb!=null){InputSystem.QueueStateEvent(kb,new KeyboardState());InputSystem.RemoveDevice(kb);if(mouse!=null)InputSystem.RemoveDevice(mouse);}EditorApplication.update-=Tick;EditorApplication.Exit(1);}}
}
