  if(phase==4){Walk(node.transform.position,.8f);foreach(var loot in UnityEngine.Object.FindObjectsByType<LootPickup>(FindObjectsSortMode.None).Where(l=>l.Gear==null&&l.Kind==MaterialKind.Wood))Stage2Experiment.Pickup(loot,s.hero.Inventory);if(s.hero.Inventory.Count(MaterialKind.Wood)>0){initialEarned=(int[])s.Flow.ActiveRun.earnedRemaining.Clone();if(s.hero.Inventory.Count(MaterialKind.Wood)<8){phase=1;return;}Mark("ACTUAL_WOOD_PICKUP wood="+s.hero.Inventory.Count(MaterialKind.Wood));if(Strategy=="Land"||Strategy=="Lake"){Need(Stage2Experiment.Cost("gathered-pre-boss-weapon",()=>s.hero.GetComponent<AdventureLoadout>().Craft((GearType)Stage2Experiment.Config.weapon,GearQuality.White)),"gathered weapon manufacture");Mark("ACTUAL_GATHER_CRAFT_PRE_BOSS");phase=80;}else phase=Strategy=="Gather"?20:10;}return;}
