  minEliteDistance=Mathf.Min(minEliteDistance,Vector3.Distance(s.hero.transform.position,region.Layout.points.Single(p=>p.id=="poi:4").position));if(Strategy=="Bypass")Need(minEliteDistance>22&&s.enemies.Where(e=>e.GetComponent<EncounterGuard>()?.poi=="poi:4").All(e=>!e.Health.Dead&&e.GetComponent<EncounterGuard>().State==0),"elite bypass state changed");
