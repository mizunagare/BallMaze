actions.csv",$"{Time.time:0.00},basic,{enemy.entityId}\n");}
  if((int)s.hero.GetComponent<AdventureLoadout>().Weapon>=2&&Vector3.Distance(enemy.transform.position,s.hero.transform.position)<3){var away=s.hero.transform.position+Vector3.ProjectOnPlane(s.hero.transform.position-enemy.transform.position,Vector3.up).normalized*4;if(region.TryGround(away,3,out var p))Walk(p,.7f);}return true;
