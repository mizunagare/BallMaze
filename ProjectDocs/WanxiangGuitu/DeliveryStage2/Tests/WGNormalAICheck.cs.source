 static void Tick(){try{EditorApplication.QueuePlayerLoopUpdate();Application.runInBackground=true;view?.Repaint();if(EditorApplication.timeSinceStartup>deadline)throw new Exception("B4 normal timeout phase="+phase+" strategy="+Strategy);if(!EditorApplication.isPlaying)return;if(mouse!=null)InputSystem.QueueStateEvent(mouse,new MouseState());
