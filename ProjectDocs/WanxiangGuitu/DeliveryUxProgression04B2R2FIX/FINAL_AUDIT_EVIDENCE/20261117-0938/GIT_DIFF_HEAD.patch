+    static bool ProjectBoard(List<GearItem> copy,string mainId,string reserveId,GearItem candidate,GearItem previous,
+        Vector2Int target,int turn,bool replace,out bool swapped,out string reason)
+    {
+        swapped=false;reason="";
+        if(candidate.Container||candidate.id==mainId||candidate.id==reserveId)
+        {reason="容器或携带武器不能放入装备盘。";return false;}
+        if(replace&&(!previous.board||previous.worn||previous.overflow||previous.id==mainId||previous.id==reserveId))
+        {reason="指定旧件不是可替换的真实盘内装备。";return false;}
+        var cells=PositionedCells(candidate,target.x,target.y,turn);
+        var collisions=copy.Where(i=>i!=candidate&&i.board&&!i.worn&&!i.overflow&&PositionedCells(i,i.x,i.y,i.rotation).Overlaps(cells)).ToArray();
+        if(collisions.Length>0)
+        {
+            if(!replace||collisions.Length!=1||collisions[0].id!=previous.id)
+            {reason="目标碰撞非指定旧件或多件装备，操作已取消。";return false;}
+            // No Find fallback: a failed bidirectional exchange stays a failure.
+            if(!PlaceState(copy,mainId,reserveId,candidate,true,target.x,target.y,turn,true,out reason))return false;
+            swapped=true;
+        }
+        else
+        {
+            if(replace){previous.board=false;previous.overflow=true;previous.x=previous.y=-1;}
+            if(!PlaceState(copy,mainId,reserveId,candidate,true,target.x,target.y,turn,false,out reason))return false;
+            if(replace)
+            {
+                if(!Find(copy,ContainerFor(copy,false),previous,false,out var back,out var oldTurn))
+                {reason="背包无法安全收回指定旧件，操作已取消。";return false;}
+                previous.x=back.x;previous.y=back.y;previous.rotation=oldTurn;previous.overflow=false;
+            }
+        }
+        return true;
+    }
