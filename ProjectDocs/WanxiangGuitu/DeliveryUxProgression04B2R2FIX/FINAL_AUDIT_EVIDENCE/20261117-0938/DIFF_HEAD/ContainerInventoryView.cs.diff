+using System;
+using System.Collections.Generic;
+using System.Linq;
+using UnityEngine;
+
+// Uses the existing pause/menu surface so combat and hotkeys keep their current behavior.
+public static class ContainerInventoryView
+{
+    // R2: one UI-only request/result shared by both surfaces. Never writes live gear.
+    public sealed class ReplacementSession
+    {
+        public bool open, replace, evaluated;
+        public string candidateId, replacedId, commitResult="";
+        public Vector2Int target;
+        public B2EquipRole role=B2EquipRole.Board;
+        public int rotation;
+        public B2AttackEvaluation result;
+        public B2AttackEvaluation LastEvaluation=>result;
+        public bool LastCommitSucceeded {get;private set;}
+        public string LastCommitReason {get;private set;}
+        public bool FixedPosition=>role==B2EquipRole.Main||role==B2EquipRole.Reserve;
+        public void Open(){CancelInteraction();open=true;replace=false;candidateId=replacedId=null;target=Vector2Int.zero;role=B2EquipRole.Board;rotation=0;Invalidate();}
+        public void Invalidate(){evaluated=false;commitResult="";}
+        public void Mode(bool value){replace=value;Invalidate();}
+        public void Candidate(AdventureLoadout gear,string id){candidateId=id;var item=gear.items.Find(i=>i.id==id);if(item!=null){rotation=item.rotation;if(FixedPosition)target=new Vector2Int(item.x,item.y);}if(role==B2EquipRole.Worn||role==B2EquipRole.ContainerRig||role==B2EquipRole.ContainerBag){target=new Vector2Int(-1,-1);rotation=0;}Invalidate();}
+        public void Replaced(AdventureLoadout gear,string id){replacedId=id;var item=gear.items.Find(i=>i.id==id);if(item!=null&&role==B2EquipRole.Board)target=new Vector2Int(item.x,item.y);Invalidate();}
+        public void Role(AdventureLoadout gear,B2EquipRole value){role=value;var item=gear.items.Find(i=>i.id==(FixedPosition?candidateId:replacedId));if(item!=null&&(FixedPosition||replace&&role==B2EquipRole.Board)){target=new Vector2Int(item.x,item.y);if(FixedPosition)rotation=item.rotation;}if(role==B2EquipRole.Worn||role==B2EquipRole.ContainerRig||role==B2EquipRole.ContainerBag){target=new Vector2Int(-1,-1);rotation=0;}Invalidate();}
+        public void Step(int x,int y){if(FixedPosition)return;target+=new Vector2Int(x,y);Invalidate();}
+        public void Rotate(){rotation=(rotation+1)%4;Invalidate();}
+        public void Evaluate(AdventureLoadout gear){result=replace?gear.PreviewReplace(candidateId,replacedId,target,role,rotation):gear.PreviewAdd(candidateId,target,role,rotation);evaluated=true;commitResult="";}
